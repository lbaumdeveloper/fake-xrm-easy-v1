<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FakeXrmEasy</RootNamespace>
    <AssemblyName>FakeXrmEasy</AssemblyName>
    <Version>1.59.0</Version>
    <PackageId>__COMPANY__.FakeXrmEasy.v9</PackageId>
    <Authors>__COMPANY__</Authors>
    <Company>__COMPANY__</Company>
    <Description>In-memory fake of IOrganizationService for unit testing plugins and custom workflow activities on Dynamics 365 CE on-premises v9. Fork of FakeXrmEasy v1.</Description>
    <PackageTags>dynamics;crm;xrm;dataverse;testing;fake;plugins</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2014-2016 Jordi Montana and contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FakeItEasy" Version="8.3.0" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.CrmSdk.Deployment" Version="9.0.2.34" />
    <PackageReference Include="Microsoft.CrmSdk.Workflow" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="9.1.1.103" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Activities" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>
</Project>
